{
  "name": "made-in-common.dev",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://roe.dev"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "og": "node scripts/og.ts",
    "sync-teams": "node scripts/sync-teams.ts",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "test:types": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui"
  },
  "dependencies": {
    "@comark/vue": "^0.9.2",
    "@nuxt/devtools": "^4.2.0",
    "@nuxt/eslint": "^1.15.2",
    "comark": "^0.9.2",
    "nuxt": "npm:nuxt-nightly@^5.0.0-2611221443-187e8c3",
    "vue": "3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.4.0",
    "@playwright/test": "1.62.1",
    "@takumi-rs/core": "2.13.3",
    "@takumi-rs/helpers": "2.13.3",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.5.0",
    "beasties": "^0.5.5",
    "eslint": "10.9.1",
    "fontless": "^1.3.4",
    "happy-dom": "20.12.0",
    "nano-staged": "1.0.2",
    "playwright-core": "1.62.1",
    "simple-git-hooks": "2.14.0",
    "subset-font": "^2.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "pnpm eslint --fix"
    ]
  }
}